<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ExtractorIr" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
    </style>

    <style name="Theme.ExtractorIr.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@color/button_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="RemoteButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_height">72dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RemoteButton.Light">
        <item name="android:background">@drawable/bg_button_light</item>
        <item name="android:textColor">@color/text_on_light</item>
    </style>

    <style name="RemoteButton.Fan">
        <item name="android:background">@drawable/bg_button_fan</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="RemoteButton.Stop">
        <item name="android:background">@drawable/bg_button_stop</item>
        <item name="android:textColor">@color/text_on_light</item>
    </style>
</resources>
